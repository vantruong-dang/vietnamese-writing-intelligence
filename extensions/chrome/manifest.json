{
  "manifest_version": 3,
  "name": "VWI - Trợ lý Văn phong Tiếng Việt",
  "version": "0.3.1",
  "description": "Kiểm toán văn phong, phát hiện câu què, văn dịch thô và sáo ngữ AI bằng lõi Rust WebAssembly siêu tốc chạy 100% Offline.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kiểm toán văn bản tiếng Việt"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://docs.google.com/*",
        "https://www.facebook.com/*",
        "https://notion.so/*",
        "https://*.notion.site/*",
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["wasm/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
