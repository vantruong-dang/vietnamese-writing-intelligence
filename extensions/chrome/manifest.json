{
  "manifest_version": 3,
  "name": "VWI - Sửa Lỗi Gõ Tiếng Việt Hay Gặp",
  "short_name": "VWI",
  "version": "0.3.2",
  "description": "Công cụ sửa lỗi gõ, lỗi chính tả và ngữ pháp tiếng Việt hay gặp. Chạy 100% Offline bằng WebAssembly siêu tốc.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VWI - Sửa Lỗi Gõ Tiếng Việt Hay Gặp"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
