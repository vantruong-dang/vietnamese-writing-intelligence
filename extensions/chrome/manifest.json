{
  "manifest_version": 3,
  "name": "VWI - Kiểm Tra Ngữ Pháp Tiếng Việt",
  "short_name": "VWI",
  "version": "0.3.1",
  "description": "Công cụ kiểm tra lỗi ngữ pháp, câu thiếu chủ ngữ và chính tả tiếng Việt. Chạy 100% Offline bằng WebAssembly siêu tốc.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kiểm tra ngữ pháp tiếng Việt"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
